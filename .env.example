# Application
APP_ENV=development
APP_NAME=secure-three-tier-devsecops-platform
APP_PORT=8000

# PostgreSQL - local development only
POSTGRES_DB=devsecops_db
POSTGRES_USER=devsecops_user
POSTGRES_PASSWORD=change-this-local-only

# Backend database connection
DATABASE_URL=postgresql://devsecops_user:change-this-local-only@db:5432/devsecops_db

# Frontend
FRONTEND_PORT=8080
